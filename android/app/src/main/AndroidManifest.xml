<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- requirements.md Principle #1 is "offline-only, no network calls at all",
         and S14 says to state that in the store listing. Transitive AARs
         quietly undermine it: Media3 (pulled in by flutter_compress and
         video_player) declares ACCESS_NETWORK_STATE and WAKE_LOCK for its
         streaming code paths, which Cairn never touches — it only ever reads
         local files. A Play listing showing network access next to a "no
         network" promise is worth more than the permissions cost.

         INTERNET is not listed here: Flutter declares it only in its debug and
         profile manifests (for hot reload), so release builds already ship
         without it. Verified against the release merged manifest. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!-- flutter_compress starts a foreground service only when
         keepAliveInBackground is true. lib/domain/encoding_profile.dart sets it
         false, so these three are dead weight.

         These two settings MUST agree. The plugin's guide claims a stripped
         permission "does not crash the encode"; on Android 14+ that is wrong —
         its service calls startForeground() unconditionally and the resulting
         SecurityException kills the app on every video save. Measured on a
         Pixel 7 Pro (API 37). test/manifest_consistency_test.dart pins the two
         together so the pair cannot drift again.

         To enable background encoding: delete these three removals AND flip
         keepAliveInBackground to true. Never one without the other. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />

    <!-- Location is opt-in and off by default (S5). Declared coarse-only: an
         entry wants "roughly where", not lane-level accuracy, and asking for
         FINE would be a bigger claim than the feature makes. Cairn never sends
         it anywhere; it is stored in the local database like everything else. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Media stays in the app's private documents dir (S9), never the shared
         gallery, so the legacy external-storage permissions are not needed.
         These come from image_picker and from flutter_compress's
         saveToDownloads(), which Cairn does not call. Export goes through the
         system share sheet instead (S11). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:label="cairn"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
